{
  "descripcion": "Vectores compartidos entre la API (C#) y la app (TypeScript) para la progresión de carga y el estancamiento (ADR-0004). Cualquier cambio de regla se hace aquí primero.",
  "advice": [
    {
      "name": "serie 1 en 12 y serie 2 en 8 sube a la siguiente carga",
      "log": { "loadKg": 22.5, "firstSet": 12, "secondSet": 8, "assisted": 5 },
      "availableLoads": [20, 22.5, 25, 27.5],
      "expected": { "action": "subir", "nextLoadKg": 25, "missingLoadData": false }
    },
    {
      "name": "serie 1 en 11 mantiene",
      "log": { "loadKg": 22.5, "firstSet": 11, "secondSet": 9, "assisted": 5 },
      "availableLoads": [20, 22.5, 25],
      "expected": { "action": "mantener", "nextLoadKg": 22.5, "missingLoadData": false }
    },
    {
      "name": "serie 2 en 7 propias mantiene",
      "log": { "loadKg": 22.5, "firstSet": 12, "secondSet": 7, "assisted": 6 },
      "availableLoads": [20, 22.5, 25],
      "expected": { "action": "mantener", "nextLoadKg": 22.5, "missingLoadData": false }
    },
    {
      "name": "sin carga superior mantiene y avisa que falta el dato",
      "log": { "loadKg": 25, "firstSet": 12, "secondSet": 8, "assisted": 5 },
      "availableLoads": [20, 22.5, 25],
      "expected": { "action": "mantener", "nextLoadKg": 25, "missingLoadData": true }
    },
    {
      "name": "las repeticiones asistidas no cuentan para subir",
      "log": { "loadKg": 22.5, "firstSet": 12, "secondSet": 6, "assisted": 9 },
      "availableLoads": [20, 22.5, 25],
      "expected": { "action": "mantener", "nextLoadKg": 22.5, "missingLoadData": false }
    }
  ],
  "loads": [
    {
      "name": "mancuernas usan la lista ordenada y sin repetidos",
      "profile": { "dumbbellsKg": [22.5, 20, 25, 20], "barsKg": { "recta": 20, "z": 8 }, "discsKg": [], "machineStepKg": 5, "machineBaseKg": 0 },
      "kind": "Mancuernas", "bar": null, "stepOverride": null, "take": null,
      "expected": [20, 22.5, 25]
    },
    {
      "name": "barra suma la barra y las combinaciones de discos por ambos lados",
      "profile": { "dumbbellsKg": [], "barsKg": { "recta": 20, "z": 8 }, "discsKg": [2.5, 5], "machineStepKg": 5, "machineBaseKg": 0 },
      "kind": "Barra", "bar": "Recta", "stepOverride": null, "take": null,
      "expected": [20, 25, 30, 35]
    },
    {
      "name": "cada tipo de barra usa su propio peso",
      "profile": { "dumbbellsKg": [], "barsKg": { "recta": 20, "z": 8 }, "discsKg": [5], "machineStepKg": 5, "machineBaseKg": 0 },
      "kind": "Barra", "bar": "Z", "stepOverride": null, "take": null,
      "expected": [8, 18]
    },
    {
      "name": "una barra sin peso registrado no tiene cargas",
      "profile": { "dumbbellsKg": [], "barsKg": { "recta": 20, "z": 8 }, "discsKg": [5], "machineStepKg": 5, "machineBaseKg": 0 },
      "kind": "Barra", "bar": "Smith", "stepOverride": null, "take": null,
      "expected": []
    },
    {
      "name": "máquina usa el escalón del perfil y la carga base",
      "profile": { "dumbbellsKg": [], "barsKg": {}, "discsKg": [], "machineStepKg": 5, "machineBaseKg": 10 },
      "kind": "Maquina", "bar": null, "stepOverride": null, "take": 3,
      "expected": [10, 15, 20]
    },
    {
      "name": "máquina con escalón propio usa ese escalón",
      "profile": { "dumbbellsKg": [], "barsKg": {}, "discsKg": [], "machineStepKg": 5, "machineBaseKg": 10 },
      "kind": "Maquina", "bar": null, "stepOverride": 2.5, "take": 3,
      "expected": [10, 12.5, 15]
    },
    {
      "name": "peso corporal no tiene cargas",
      "profile": { "dumbbellsKg": [], "barsKg": {}, "discsKg": [], "machineStepKg": 5, "machineBaseKg": 0 },
      "kind": "PesoCorporal", "bar": null, "stepOverride": null, "take": null,
      "expected": []
    }
  ],
  "stagnation": [
    {
      "name": "3 sesiones iguales avisan con umbral 3",
      "threshold": 3,
      "history": [
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 }
      ],
      "expected": { "isStagnant": true, "sessionsWithoutProgress": 3 }
    },
    {
      "name": "2 sesiones sin progreso no avisan con umbral 3",
      "threshold": 3,
      "history": [
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 }
      ],
      "expected": { "isStagnant": false, "sessionsWithoutProgress": 2 }
    },
    {
      "name": "con umbral 2 avisan 2 sesiones sin progreso",
      "threshold": 2,
      "history": [
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 }
      ],
      "expected": { "isStagnant": true, "sessionsWithoutProgress": 2 }
    },
    {
      "name": "más repeticiones propias en la serie 2 es progreso",
      "threshold": 3,
      "history": [
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 6, "assisted": 5 }
      ],
      "expected": { "isStagnant": false, "sessionsWithoutProgress": 0 }
    },
    {
      "name": "las repeticiones asistidas no cuentan como progreso",
      "threshold": 3,
      "history": [
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 3 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 4 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 6 }
      ],
      "expected": { "isStagnant": true, "sessionsWithoutProgress": 3 }
    },
    {
      "name": "subir la carga es progreso",
      "threshold": 3,
      "history": [
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 105, "firstSet": 7, "secondSet": 4, "assisted": 5 }
      ],
      "expected": { "isStagnant": false, "sessionsWithoutProgress": 0 }
    },
    {
      "name": "bajar de carga reinicia la racha",
      "threshold": 3,
      "history": [
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 90, "firstSet": 9, "secondSet": 5, "assisted": 5 }
      ],
      "expected": { "isStagnant": false, "sessionsWithoutProgress": 0 }
    },
    {
      "name": "tras bajar de carga cuenta desde la nueva carga",
      "threshold": 3,
      "history": [
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 90, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 90, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 90, "firstSet": 9, "secondSet": 5, "assisted": 5 },
        { "loadKg": 90, "firstSet": 9, "secondSet": 5, "assisted": 5 }
      ],
      "expected": { "isStagnant": true, "sessionsWithoutProgress": 3 }
    },
    {
      "name": "una sola sesión no tiene racha",
      "threshold": 3,
      "history": [
        { "loadKg": 100, "firstSet": 9, "secondSet": 5, "assisted": 5 }
      ],
      "expected": { "isStagnant": false, "sessionsWithoutProgress": 0 }
    }
  ]
}
